# Browser (Vite-exposed) — publishable key, safe to ship to the client.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server only (never VITE_-prefixed) — Supabase secret key (sb_secret_…),
# used by api/ functions to bypass RLS. Resolves to the service_role.
# Legacy name SUPABASE_SERVICE_ROLE_KEY is still accepted as a fallback.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Server-only Portfolio Data Hub connection. Never use a VITE_ prefix.
PORTFOLIO_DATA_HUB_BASE_URL=http://127.0.0.1:8000
PORTFOLIO_DATA_HUB_API_KEY=
# Optional; defaults to 10000 and accepts 500-30000 milliseconds.
PORTFOLIO_DATA_HUB_TIMEOUT_MS=10000
