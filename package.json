    "@supabase/supabase-js": "^2.76.1",
    "decimal.js": "^10.6.0",
    "lucide-react": "^0.546.0",
    "papaparse": "^5.4.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^2.12.7",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.1",
